# ========================================================
# PET ZONE ENVIRONMENT VARIABLES (TEMPLATE)
# - Copy to .env for Local / Development:
#     cp .env.example .env
# - Copy to .env.prod for Production deployment:
#     cp .env.example .env.prod
# ========================================================

# Service & Client URLs
# For Local: http://localhost:3000, http://localhost:5173, http://localhost:8090, http://localhost:8088
# For Prod:  https://petzone.yourdomain.com, https://petzone-admin.yourdomain.com, https://petzone-api.yourdomain.com, https://petzone-auth.yourdomain.com
FRONTEND_CLIENT_URL=http://localhost:3000
FRONTEND_ADMIN_URL=http://localhost:5173
API_GATEWAY_URL=http://localhost:8090
KC_HOSTNAME=http://localhost:8088
KEYCLOAK_ISSUER_URI=http://localhost:8088/realms/super-petmark-3d

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Keycloak Identity Server
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_CLIENT_ID=user-service
KEYCLOAK_CLIENT_SECRET=your_keycloak_client_secret

# JWT Configuration
JWT_SECRET=your_jwt_secret_base64_string
JWT_EXPIRATION=86400000

# API Key (Internal service communication)
API_KEY=your_internal_api_key

# Cloudinary (for media upload)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Email (SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_email_app_password

# VNPay Sandbox
VNPAY_TMN_CODE=your_vnpay_tmn_code
VNPAY_HASH_SECRET=your_vnpay_hash_secret
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:3000/payment/callback
VNPAY_IPN_URL=http://localhost:8085/public/payments/callback/VNPAY
