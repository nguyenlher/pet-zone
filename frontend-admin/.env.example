VITE_API_BASE_URL=http://localhost:8090

# Client Web Application URL (Local: port 3000 / Prod: https://petzone.yourdomain.com)
VITE_CLIENT_URL=http://localhost:3000

# Tripo 3D AI API Key
VITE_TRIPO_API_KEY=your_tripo_api_key_here
