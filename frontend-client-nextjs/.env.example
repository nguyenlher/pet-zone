# ========================================================
# PET ZONE FRONTEND ENVIRONMENT VARIABLES (TEMPLATE)
# - Copy to .env for Local / Development:
#     cp .env.example .env
# - Copy to .env.prod for Production build:
#     cp .env.example .env.prod
# ========================================================

# NextAuth / Auth.js Configuration
AUTH_SECRET=your_auth_secret_32_characters_minimum
NEXTAUTH_URL=http://localhost:3000
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# Public Web Domain URLs
# Local: http://localhost:3000, http://localhost:5173
# Prod:  https://petzone.yourdomain.com, https://petzone-admin.yourdomain.com
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:5173

# Keycloak OIDC Provider
# Local: http://localhost:8088/realms/super-petmark-3d
# Prod:  https://petzone-auth.yourdomain.com/realms/super-petmark-3d
KEYCLOAK_CLIENT_ID=user-service
KEYCLOAK_CLIENT_SECRET=your_keycloak_client_secret
KEYCLOAK_ISSUER=http://localhost:8088/realms/super-petmark-3d
NEXT_PUBLIC_KEYCLOAK_ISSUER=http://localhost:8088/realms/super-petmark-3d

# Backend API Gateway
# Local: http://localhost:8090
# Prod:  https://petzone-api.yourdomain.com
NEXT_PUBLIC_API_GATEWAY_URL=http://localhost:8090

# Cloudflare Turnstile Captcha
# Local test site key (always passes): 1x00000000000000000000AA
NEXT_PUBLIC_CAPTCHA_SITE_KEY=1x00000000000000000000AA
# Local test secret key (always passes): 1x0000000000000000000000000000000AA
CAPTCHA_SECRET_KEY=1x0000000000000000000000000000000AA


