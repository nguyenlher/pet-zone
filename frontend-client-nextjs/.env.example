# ========================================================
# PET ZONE FRONTEND PRODUCTION ENVIRONMENT VARIABLES (TEMPLATE)
# Copy to .env or configure in Vercel Dashboard
# ========================================================

# NextAuth / Auth.js Configuration
AUTH_SECRET=your_auth_secret_32_characters_minimum
NEXTAUTH_URL=https://petzone.yourdomain.com
AUTH_URL=https://petzone.yourdomain.com
AUTH_TRUST_HOST=true

# Public Web Domain URLs
NEXT_PUBLIC_APP_URL=https://petzone.yourdomain.com
NEXT_PUBLIC_ADMIN_URL=https://petzone-admin.yourdomain.com

# Keycloak OIDC Provider Production
KEYCLOAK_CLIENT_ID=user-service
KEYCLOAK_CLIENT_SECRET=your_keycloak_client_secret
KEYCLOAK_ISSUER=https://petzone-auth.yourdomain.com/realms/super-petmark-3d
NEXT_PUBLIC_KEYCLOAK_ISSUER=https://petzone-auth.yourdomain.com/realms/super-petmark-3d

# Backend API Gateway Production
NEXT_PUBLIC_API_GATEWAY_URL=https://petzone-api.yourdomain.com
